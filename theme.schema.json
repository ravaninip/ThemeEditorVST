{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ravaninip/ThemeEditorVST/blob/main/theme.schema.json",
  "title": "Plug-in colour theme",
  "type": "object",
  "required": [
    "format",
    "version",
    "name"
  ],
  "properties": {
    "format": {
      "const": "plugin-theme"
    },
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48
    },
    "colors": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "panel": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "well": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "warm": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "text": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "dim": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "edge": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "control": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "controlEdge": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "danger": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "panelRadius": {
          "type": "number",
          "minimum": 0,
          "maximum": 24
        }
      }
    }
  },
  "description": "Structure only. Plug-ins additionally refuse themes that fail the readability rules (see docs/THEMES.md) and files larger than 8 KiB."
}
